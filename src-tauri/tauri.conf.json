{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MyTodoTracker",
  "version": "0.2.0",
  "identifier": "com.vikas.mytodotracker",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MyTodoTracker",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Offline goals and tasks tracker",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3NzQ4MEQwMDI0QUIwM0QKUldROXNFb0MwSUIwdDdGOGUrUEU4clVTdXJwREJqWUlCc1VJVTBDQnAyR0NzVEZNdzhyZUZqOEEK",
      "endpoints": [
        "https://github.com/vish9977/my-todo-tracker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}